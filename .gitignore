# Data: raw + processed corpora are large and reproducible from source.
# `archives/` holds the downloaded release tarballs (~250MB each).
# Golden sets ARE committed (they are the curated ground truth).
data/raw/
data/processed/
data/pgdata/
data/archives/
!data/golden/
!data/golden/**

# Caches
.cache/
llm_cache/
.hf_cache/
# Downloaded model weights, at the repo root only. This was once a bare
# `models/`, which also matched backend/app/models/ -- the ORM package -- so
# the database schema's source was never committed and no clone could import.
/models/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Personal AI-assistant tooling: installed per machine, not part of the project.
# (The Impeccable design skill, with a 14MB binary, was once swept into a
# commit.) `.claude/launch.json` stays: it starts this repo's two dev servers.
.claude/*
!.claude/launch.json
.github/skills/
.github/agents/
.github/hooks/
.impeccable/
