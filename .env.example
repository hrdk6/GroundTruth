# ---------------------------------------------------------------------------
# GroundTruth environment. Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Matches the docker-compose `db` service. When running the backend on the
# host (not in Compose), POSTGRES_HOST is localhost; inside Compose it is `db`.
POSTGRES_USER=groundtruth
POSTGRES_PASSWORD=groundtruth
POSTGRES_DB=groundtruth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full URL overrides the parts above when set (useful for managed Postgres).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- LLM provider ---------------------------------------------------------
# Only needed for generation + judging. Retrieval-only evals run without any
# key at all, which is what CI does.
#
# Option A (default, per PROJECT_SPEC.md S4): Anthropic.
GT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GT_GENERATION_MODEL=claude-sonnet-5
GT_CHEAP_MODEL=claude-haiku-4-5

# Option B: any OpenAI-compatible endpoint. This is how to run the generation
# and judging phases without paying: NVIDIA NIM (build.nvidia.com) issues a key
# with no credit card. Groq, OpenRouter and a local Ollama speak the same API.
#
# Uncomment and fill in. Then run `make llm-check`, which verifies the key and
# both model ids in three calls -- including whether the model returns strict
# JSON, which the judge and the claim verifier depend on.
#
#   GT_LLM_PROVIDER=openai
#   GT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   GT_LLM_API_KEY=nvapi-...
#
# Two models, chosen for different jobs. The cheap one does the heavy lifting:
# claim verification makes ~4 calls per answer and judging one more, so a slow
# reasoning model there turns a 30-minute eval into an overnight one. NVIDIA's
# free tier allows 40 requests/minute; the client backs off and retries on 429.
#
#   GT_GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b
#   GT_CHEAP_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#
# The live catalogue is public, no key needed:
#   curl -s https://integrate.api.nvidia.com/v1/models | python -m json.tool
#
# Cost per million tokens. Zero is correct for a free tier and WRONG for a paid
# one -- set these or every cost figure in the repo under-reports.
#   GT_LLM_COST_PER_MTOK_IN=0.0
#   GT_LLM_COST_PER_MTOK_OUT=0.0
GT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GT_RERANKER_MODEL=BAAI/bge-reranker-base

# --- Runtime --------------------------------------------------------------
GT_LOG_LEVEL=INFO
GT_LOG_FORMAT=console          # console | json
GT_LLM_CACHE_DIR=.cache/llm
GT_LLM_CACHE_ENABLED=true

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
