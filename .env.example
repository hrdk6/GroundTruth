# ---------------------------------------------------------------------------
# GroundTruth environment. Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Matches the docker-compose `db` service. When running the backend on the
# host (not in Compose), POSTGRES_HOST is localhost; inside Compose it is `db`.
POSTGRES_USER=groundtruth
POSTGRES_PASSWORD=groundtruth
POSTGRES_DB=groundtruth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full URL overrides the parts above when set (useful for managed Postgres).
# The `postgres://` and `postgresql://` forms managed hosts print are accepted
# as given and pointed at psycopg 3.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- LLM provider ---------------------------------------------------------
# Only needed for generation + judging. Retrieval-only evals run without any
# key at all, which is what CI does.
#
# Option A (default, per PROJECT_SPEC.md S4): Anthropic.
GT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GT_GENERATION_MODEL=claude-sonnet-5
GT_CHEAP_MODEL=claude-haiku-4-5

# Option B: Groq, free, no credit card (console.groq.com). It speaks the OpenAI
# API, so nothing else changes. Uncomment, fill in the key, then run
# `make llm-check`: it verifies the key and both model ids, and whether the
# cheap model returns strict JSON, which the judge and the claim verifier need.
#
#   GT_LLM_PROVIDER=openai
#   GT_LLM_BASE_URL=https://api.groq.com/openai/v1
#   GT_LLM_API_KEY=gsk_...
#   GT_GENERATION_MODEL=openai/gpt-oss-120b
#   GT_CHEAP_MODEL=openai/gpt-oss-20b
#
# Which models a key can use varies by account: on the key this was tested
# with (10 Oct 2026) the Llama models in Groq's docs returned 404, and the chat
# models served were openai/gpt-oss-120b, openai/gpt-oss-20b and the preview
# qwen/qwen3.8-27b. List yours before choosing:
#   curl -s -H "Authorization: Bearer $GT_LLM_API_KEY" https://api.groq.com/openai/v1/models
# Two different models on purpose: the cheap one verifies claims (~4 calls an
# answer) and judges, and it should not be the model that wrote the answer.
# All three are reasoning models; the client's token floor allows for that.
# Answers vary run to run: on five answerable questions, cache off, each
# pairing answered four and withheld one.
#
# Groq limits TOKENS per minute as well as requests, per model and per account
# (see console.groq.com/settings/limits). A full question sends several thousand
# tokens, so the limit that bites is usually tokens. The client waits as long as
# the server's Retry-After says (up to 60 s) and retries; raise
# GT_LLM_MAX_ATTEMPTS if you see "verifier unavailable" under load.
#
# Option C: NVIDIA NIM (build.nvidia.com), also free. Its catalogue overstates
# what is served: most listed models time out or 404, so check with
# `make llm-check` before relying on one.
#
#   GT_LLM_PROVIDER=openai
#   GT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   GT_LLM_API_KEY=nvapi-...
#   GT_GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b
#   GT_CHEAP_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#
# Cost per million tokens. Zero is correct for a free tier and WRONG for a paid
# one -- set these or every cost figure in the repo under-reports.
#   GT_LLM_COST_PER_MTOK_IN=0.0
#   GT_LLM_COST_PER_MTOK_OUT=0.0
GT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GT_RERANKER_MODEL=BAAI/bge-reranker-base

# --- Runtime --------------------------------------------------------------
GT_LOG_LEVEL=INFO
GT_LOG_FORMAT=console          # console | json
GT_LLM_CACHE_DIR=.cache/llm
GT_LLM_CACHE_ENABLED=true

# Concurrent model calls per request (claim verification fans out one call per
# sentence). Latency only: every call is cached under its own prompt.
GT_LLM_MAX_CONCURRENCY=4

# --- API ------------------------------------------------------------------
# Pipeline `/query` runs when the caller names none. `full` is the shipping one.
GT_DEFAULT_CONFIG=full
# Browser origins allowed to call the API directly (a JSON list).
# GT_CORS_ORIGINS=["http://localhost:3000"]
# Enables POST /ingest. Unset = the admin endpoints answer 404.
# GT_ADMIN_TOKEN=
# Traces older than this many days are deleted by the API. 0 keeps them forever.
# GT_TRACE_RETENTION_DAYS=30
# Pipelines /query will run, as JSON. Unset serves every file in configs/;
# a public server should leave out the rerank configs (~1 GB model each).
# GT_SERVED_CONFIGS=["full","baseline","hybrid_bm25"]
# Admission control for /query: questions per minute across all clients
# (0 = no limit), and how many run at once before others wait, then get 503.
# GT_QUERY_RATE_PER_MINUTE=30
# GT_MAX_CONCURRENT_QUERIES=4
# Provider attempts per model call. 5 suits evals; a web server wants ~2.
# GT_LLM_MAX_ATTEMPTS=5

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
